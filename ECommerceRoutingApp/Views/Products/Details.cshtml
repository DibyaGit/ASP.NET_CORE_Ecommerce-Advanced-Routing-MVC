@{
    ViewData["Title"] = "Product Details";
}

<div style="padding: 20px; font-family: sans-serif;">
    <h2>🛍️ Store Item Details</h2>
    <hr />
    <p>You are viewing an item in the <strong>@ViewBag.Category</strong> department.</p>
    <p>The specific product ID is: <span style="font-size: 1.2em; color: green;">@ViewBag.Id</span></p>
</div>